{
  "name": "zerortc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "relay": "tsx server/signaling-relay.ts",
    "dev:call": "npm run relay & npm run dev",
    "build": "npm run build -w @zerortc/core && npm run build -w @zerortc/mesh && npm run build -w @zerortc/telemetry && vite build",
    "build:packages": "npm run build -w @zerortc/core && npm run build -w @zerortc/mesh && npm run build -w @zerortc/telemetry",
    "preview": "vite preview",
    "clean": "rm -rf dist packages/*/dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@zerortc/core": "*",
    "@zerortc/mesh": "*",
    "@zerortc/telemetry": "*",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
